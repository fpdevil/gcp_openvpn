# Set  Standard Tier  as  the default  for all  projects,  unless it  is
# critical like  production. The Standard  Tier does not  support global
# load balancing,  Cloud CDN, or Anycast  IPs. So, If any  such features
# are required,  use Premium Tier  for those specific resources.  We may
# also mix tiers within the same project.
resource "google_compute_project_default_network_tier" "default" {
  project      = var.project_id
  network_tier = "STANDARD"
}

# Create VM Instance and associate with the VPC & Subnets
resource "google_compute_instance" "openvpn_vm" {
  name         = var.vm_name
  machine_type = var.machine_type
  zone         = var.zone
  labels       = var.labels

  boot_disk {
    initialize_params {
      image = "projects/ubuntu-os-cloud/global/images/ubuntu-minimal-2510-questing-amd64-v20260211"
      type  = "pd-standard"
      labels = {
        instance = "openvpn-vm",
        purpose  = "openvpn-network",
        region   = var.region
      }
    }
  }

  network_interface {
    network    = google_compute_network.main.self_link
    subnetwork = google_compute_subnetwork.public_subnet.self_link

    # Conditionally add an external IP
    # if we go with default, an external ip will be created
    # For dedicated static public IP, use below inside aaccess_config
    # nat_ip = google_compute_address.public_ip.address
    access_config {
      # Ephemeral Public IP Address or Static IP
      nat_ip = var.need_external_ip ? google_compute_address.static_public_ip[0].address : null
    }
  }

  connection {
    type        = "ssh"                                             # connection type
    user        = var.username                                      # username for authentication
    host        = self.network_interface[0].access_config[0].nat_ip # vm public ip
    timeout     = "500s"                                            # connection timeout
    private_key = file(local.private_key_filename)                  # ssh key to connect with
  }

  # ensure that the firewall rule is provisioned before vm instance
  # is created so that ssh does not fail
  depends_on = [
    google_compute_firewall.firewall
  ]

  metadata = {
    ssh-keys = "${var.username}:${tls_private_key.ssh.public_key_openssh}"
  }

  # metadata_startup_script = file("startup.sh")
  metadata_startup_script = var.enable_startup_script ? file(local.startup) : null

  # file provisioner to copy the below scripts to VM created
  # prerequisites.sh, master.sh and validate_configurations.sh
  provisioner "file" {
    source      = local.openvpn
    destination = "/home/${var.username}/openvpn.sh"
  }

  # execute the scripts on remote VM
  provisioner "remote-exec" {
    inline = [
      "chmod +x /home/${var.username}/openvpn.sh",
      "bash /home/${var.username}/openvpn.sh"
    ]
    on_failure = continue
  }

  # Wait for OpenVPN installation to complete and file to be created
  provisioner "remote-exec" {
    inline = [
      "while [ ! -f /home/${var.username}/${local.openvpn_file} ]; do sleep 20; echo 'Waiting for OpenVPN config file...'; done",
      "echo 'OpenVPN config file is ready!'"
    ]
  }

  provisioner "local-exec" {
    command = <<EOT
    mkdir -p ${var.ovpn_config_dir};
    scp -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -i ${local.private_key_filename} ${var.username}@${google_compute_instance.openvpn_vm.network_interface[0].access_config[0].nat_ip}:/home/${var.username}/${local.openvpn_file} ./${local.openvpn_file}
    EOT
  }

  tags = [
    for x in var.firewall : x["target_tags"][0]
  ]
}
